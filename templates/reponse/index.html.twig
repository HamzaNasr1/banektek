{% extends 'base.html.twig' %}

{% block title %}Reponse index{% endblock %}

{% block body %}
    <h1>Reponse index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Date_reponse</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for reponse in reponses %}
            <tr>
                <td>{{ reponse.id }}</td>
                <td>{{ reponse.dateReponse ? reponse.dateReponse|date('Y-m-d H:i:s') : '' }}</td>
                <td>
                    <a href="{{ path('app_reponse_show', {'id': reponse.id}) }}">show</a>
                    <a href="{{ path('app_reponse_edit', {'id': reponse.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_reponse_new') }}">Create new</a>
    // Dans votre modèle de vue (template), itérez sur les réponses et ajoutez le code HTML/JavaScript pour chaque réponse
{% for reponse in reponses %}
    <div>
        {{ reponse.contenu }} <!-- Affiche le contenu de la réponse -->
        <!-- Système de notation (rating) -->
        <i class="star" data-note="1">&#9733;</i>
        <i class="star" data-note="2">&#9733;</i>
        <i class="star" data-note="3">&#9733;</i>
        <i class="star" data-note="4">&#9733;</i>
        <i class="star" data-note="5">&#9733;</i>
        <i class="note">Note:</i>
    </div>
{% endfor %}

{% endblock %}

