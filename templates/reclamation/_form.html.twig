  <!-- Contact Section -->
 
    <section id="contact">
        <div class="container">
            <div class="contact-card">
                <div class="infos">
                    <h6 class="section-subtitle">Get Here</h6>
                    <h6 class="section-title mb-4">Contact Us</h6>

                    <div class="item">
                        <i class="ti-location-pin"></i>
                        <div class="">
                            <h5>Location</h5>
                            <p> 12345 Fake ST NoWhere AB Country</p>
                        </div>                          
                    </div>
                    <div class="item">
                        <i class="ti-mobile"></i>
                        <div>
                            <h5>Phone Number</h5>
                            <p>(123) 456-7890</p>
                        </div>                          
                    </div>
                    <div class="item">
                        <i class="ti-email"></i>
                        <div class="mb-0">
                            <h5>Email Address</h5>
                            <p>info@website.com</p>
                        </div>
                    </div>
                    <div class="item">
                        <i class="ti-world"></i>
                        <div class="mb-0">
                            <h5>example.com</h5>
                            <p>info@example.com</p>
                        </div>
                    </div>
                </div>
                <div class="form">
                    <h6 class="section-subtitle">Available 24/7</h6>
                    <h6 class="section-title mb-4">Get In Touch</h6>
                    {{ form_start(form,{'attr':{'novalidate':'novalidate'}})}}
    <div class="form-group">
        {{ form_widget(form.email, {'attr': {'class': 'form-control form-control-lg', 'placeholder': 'abc@banektek.com'}}) }}
    </div>
    {% if form_errors(form.email) %}
                                <div class="alert alert-danger">
                                    {{ form_errors(form.email) }}
                                </div>
                                {% endif %}
    <div class="form-group">
        {{ form_widget(form.type, {'attr': {'class': 'form-control form-control-lg', 'placeholder': 'Choisir type'}}) }}
    </div>
    {% if form_errors(form.document) %}
    <div class="alert alert-danger">
        {{ form_errors(form.document) }}
    </div>
    {% endif %}
    <div class="form-group">
        {{ form_widget(form.document, {'attr': {'class': 'form-control form-control-lg', 'accept': '.jpg, .jpeg, .png', 'placeholder': 'Document'}}) }}
    </div>
  
    <div class="form-group">
        {{ form_widget(form.description, {'attr': {'class': 'form-control form-control-lg', 'placeholder': 'Description'}}) }}
    </div>
    {% if form_errors(form.description) %}
                                <div class="alert alert-danger">
                                    {{ form_errors(form.description) }}
                                </div>
                                {% endif %}
    <button type="submit" class="btn btn-primary btn-block btn-lg mt-3">Send Message</button>
{{ form_end(form) }}

                </div>
            </div>
        </div>
    </section>
    <!-- Contact Section -->
