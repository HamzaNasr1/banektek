  <!-- Contact Section -->
 
  <section id="contact">
   <div class="container">
      
         <div class="form">
            <h6 class="section-title mb-4">Envoyer reclamation</h6>
            {{ form_start(form,{'attr':{'novalidate':'novalidate'}})}}
            <div class="form-group">
               {{ form_widget(form.type, {'attr': {'class': 'form-control form-control-lg', 'placeholder': 'Choisir type'}}) }}
            </div>
            <div class="form-group">
               {{ form_widget(form.document, {'attr': {'class': 'form-control form-control-lg', 'accept': '.jpg, .jpeg, .png', 'placeholder': 'Document'}}) }}
            </div>
            <div class="form-group">
               {{ form_widget(form.description, {'attr': {'class': 'form-control form-control-lg', 'placeholder': 'Description'}}) }}
            </div>*
            {% if form_errors(form.description) %}
            <div class="alert alert-danger">
                {{ form_errors(form.description) }}
            </div>
            {% endif %}
            <button type="submit" class="btn btn-primary btn-block btn-lg mt-3" style="background-color:#003883">Reclamer</button>
            {{ form_end(form) }}
         </div>
      </div>
   </div>
</section>
<!-- Contact Section -->