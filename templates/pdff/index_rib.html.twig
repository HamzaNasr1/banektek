<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Liste des ribs</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f5f5f5;
            margin: 0;
            padding: 20px;
        }

        h1 {
            color: #333;
            text-align: center;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

        th, td {
            border: 1px solid #ddd;
            padding: 12px;
            text-align: left;
        }

        th {
            background-color: #f2f2f2;
            font-weight: bold;
            color: red; /* Set th text color to red */
        }

        tbody tr:hover {
            background-color: #f9f9f9;
        }

        .category-column {
            width: 20%;
        }

        .price-column {
            width: 15%;
        }

        .description-column {
            width: 35%;
        }

        .name-column {
            width: 20%;
        }

        .currency {
            font-weight: bold;
        }
    </style>
</head>
<body>
<h1>RIB</h1>
<table>
    <thead>
    <tr>
        <th>Etat</th>
        <th class="versement-column">Type compte</th>
        <th class="retrait-column">RIB</th>
    </tr>
    </thead>
    <tbody>
   
{% for compte in comptes %}
                          
                        
                            <tr role="row" class="odd">
                     

                               
                                <td>{{compte.etat}}</td>
                                <td>{{compte.type}}</td>
                                <td>{{compte.rib}}</td>
                            </tr>
                          {% endfor %}




 {#{% for compte in client[0].getIdUser %}
                          
                        
                            <tr role="row" class="odd">
                     

                               
                                <td>{{client.id_user}}</td>
                                <td>{{compte.type}}</td>
                                <td>{{compte.rib}}</td>
                            </tr>
                          {% endfor %}#} 


    </tbody>
</table>
</body>
</html>