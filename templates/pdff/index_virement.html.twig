<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Liste des virements</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f5f5f5;
            margin: 0;
            padding: 20px;
        }

        h1 {
            color: #333;
            text-align: center;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

        th, td {
            border: 1px solid #ddd;
            padding: 12px;
            text-align: left;
        }

        th {
            background-color: #f2f2f2;
            font-weight: bold;
            color: red; /* Set th text color to red */
        }

        tbody tr:hover {
            background-color: #f9f9f9;
        }

        .category-column {
            width: 20%;
        }

        .price-column {
            width: 15%;
        }

        .description-column {
            width: 35%;
        }

        .name-column {
            width: 20%;
        }

        .currency {
            font-weight: bold;
        }
    </style>
</head>
<body>
<h1> Liste des virement</h1>
<table>
    <thead>
    <tr>
        <th>Date de virement</th>
        <th class="versement-column">Type de virement</th>
        <th class="retrait-column">Montant</th>
    </tr>
    </thead>
    <tbody>
   



   {% for compte in comptes %}
     {% for virement in compte.getVirements %}
                          
                        
                            <tr role="row" class="odd">
                             <td class="sorting_1">{{virement.dateApprobation|date('Y-m-d H:i:s')}}</td>

                               {#<td class="sorting_1">{{virement.date_emission|date('Y-m-d H:i:s')}}</td>#} 
                                <td>{{virement.type.nom}}</td>
                                <td>{{virement.montant}}</td>
                            </tr>
                          {% endfor %}
    {% endfor %}

    </tbody>
</table>
</body>
</html>