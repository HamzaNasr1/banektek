        simulatorResult1.style.display = "block"; //affichage 

        // Get the input values
        const acquisitionPrice = parseFloat(document.getElementById("edit-acquisition-price-input").value);
        const minCapital = parseFloat(document.getElementById("edit-min-capital-input").value);
        const duree = parseFloat(document.getElementById("edit-duration-input").value) * 12; // Convert duration to months
        const taux = 0.1; // Example interest rate

        // Calculate monthly payment
        const mensualite = (acquisitionPrice * taux) / (1 - Math.pow(1 + taux, -duree));

        // Calculate frais (1% of the acquisition price)
        const frais = acquisitionPrice * 0.01;

        // Calculate fin_sol (acquisition price minus min capital)
        const fin_sol = acquisitionPrice - minCapital;

        // Update HTML elements with new values
        document.getElementById("monthly-1").innerHTML = mensualite.toFixed(2) + " DT";
        document.getElementById("frais").innerHTML = frais.toFixed(2) + " DT";
        document.getElementById("fin_sol").innerHTML = fin_sol.toFixed(2) + " DT";
    });
});

