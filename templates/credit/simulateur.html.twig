        fetch('https://v6.exchangerate-api.com/v6/af05f542d22f61006a55ead9/latest/USD').then(response => response.json()).then(data => {
          // Extract conversion rates from the JSON data
          const conversionRates = data.conversion_rates;
          // Function to convert amount from TND to selected currency
          function convertCurrency() {
            const amount = parseFloat(document.getElementById('edit-amount').value);
            const currencyTo = document.getElementById('edit-currencyto').value;
            // Check if the selected currency is TND
            if (currencyTo === 'TND') {
              // If converting to TND, the result is the same as the input amount
              const convertedAmount = amount;
              // Update the result in the div
              const resultDiv = document.querySelector('.converter-result');
              resultDiv.innerHTML = `
																												
																																						<div class="result">
																																							<div>${convertedAmount.toFixed(2)} 
																														
																																								<span class="currency">TND</span>
																																							</div>
																																						</div>`;
            } else {
              // Convert amount from TND to selected currency
              const exchangeRate = conversionRates[currencyTo];
              if (exchangeRate) {
                const tndExchangeRate = 1 / conversionRates['TND']; // Get the exchange rate for TND
                const convertedAmount = amount * tndExchangeRate * exchangeRate;
                // Update the result in the div
                const resultDiv = document.querySelector('.converter-result');
                resultDiv.innerHTML = `
																												
																																						<div class="result">
