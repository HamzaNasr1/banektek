																																								<span class="currency">${currencyTo}</span>
																																							</div>
																																						</div>`;
              } else {
                console.error('Exchange rate not available for selected currency');
              }
            }
          }
          // Event listener for form submission
          document.getElementById('edit-submit-button').addEventListener('click', function(event) {
            event.preventDefault(); // Prevent default form submission
            convertCurrency(); // Call the conversion function
          });
          document.getElementById('edit-amount').addEventListener('input', convertCurrency);
        }).catch(error => console.error('Error fetching data:', error));
      });
