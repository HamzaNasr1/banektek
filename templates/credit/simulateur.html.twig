    <script>
      document.addEventListener("DOMContentLoaded", function() {
        // Fetch the JSON data
        fetch('https://v6.exchangerate-api.com/v6/af05f542d22f61006a55ead9/latest/USD').then(response => response.json()).then(data => {
            // Extract conversion rates from the JSON data
            const conversionRates = data.conversion_rates;

            function updateExchangeRates(conversionRates) {
              // Select all elements with the class .court-devise
              const currencyElements = document.querySelectorAll('.court-devise');
              //const tndExchangeRate = conversionRates['TND']; // Get the exchange rate for TND
              const tndExchangeRate = 1 / conversionRates['TND']; // Get the exchange rate for TND
              // Iterate over each currency element
              currencyElements.forEach(row => {
                  // Get the currency code from the element
                  const currencyCode = row.textContent.trim();
                  // Check if the currency code exists in the conversion rates data
                  if (conversionRates[currencyCode]) {
                    // Update the exchange rate for the currency
                    const exchangeRateElement = row.nextElementSibling.nextElementSibling;
                    const exchangeRateElementsell = row.nextElementSibling.nextElementSibling.nextElementSibling;
                    if (currencyCode === 'EUR') {
                      exchangeRateElement.textContent = 3.44; //(conversionRates[currencyCode] / tndExchangeRate);
                      exchangeRateElementsell.textContent = 3.34; //(conversionRates[currencyCode] * tndExchangeRate ).toFixed(3);}
                    } else {
                      exchangeRateElement.textContent = (conversionRates[currencyCode] / tndExchangeRate).toFixed(2);
                      exchangeRateElementsell.textContent = (conversionRates[currencyCode] * tndExchangeRate).toFixed(2);
                    }
                  }
                } else {
                  console.error('Exchange rate not available for currency:', currencyCode);
                }
              });
          }
          // Example usage:
          updateExchangeRates(conversionRates);
          // Optionally, you can set up a timer to periodically update the exchange rates
          // setInterval(updateExchangeRates, 60000); // Update every minute
        }).catch(error => console.error('Error fetching data:', error));
      });
    </script>
