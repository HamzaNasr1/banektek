<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>credit List</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f5f5f5;
            margin: 0;
            padding: 20px;
        }

        h1 {
            color: #333;
            text-align: center;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

        th, td {
            border: 1px solid #ddd;
            padding: 12px;
            text-align: left;
        }

        th {
            background-color: #f2f2f2;
            font-weight: bold;
            color: red; /* Set th text color to red */
        }

        tbody tr:hover {
            background-color: #f9f9f9;
        }

        .category-column {
            width: 20%;
        }

        .price-column {
            width: 15%;
        }

        .description-column {
            width: 35%;
        }

        .name-column {
            width: 20%;
        }

        .currency {
            font-weight: bold;
        }
    </style>
</head>
<body>
<h1>credit List</h1>
<table>
    <thead>
    <tr>
        <th>ID</th>
        <th class="name-column">Montant</th>
        <th class="description-column">Taux</th>
        <th class="category-column">Duree</th>
    </tr>
    </thead>
    <tbody>
    {% for credit in credits %}
        <tr>
            <td>{{ credit.id }}</td>
            <td>{{ credit.montant }}</td>
            <td>{{ credit.taux }}</td>
            <td>{{ credit.duree }}</td>
            
            
        </tr>
    {% endfor %}
    </tbody>
</table>
</body>
</html>