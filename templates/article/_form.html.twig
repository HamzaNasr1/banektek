       <article>
                 
    <div class="row">
        <div class="">
            <div class="box box-danger">
                <div class="box-header">
                    <h3 class="box-title">Formulaire D'ajout</h3>
                </div>
                <div class="box-body">
                   {{ form_start(form, {'attr': {'novalidate': 'novalidate', 'id': 'myForm'}}) }}
<!-- Date de Publication -->
<div class="row">
    <!-- Titre -->
    <div class="col-md-12">
        <div class="form-group">
            {{ form_label(form.titre) }}
            <div class="input-group">
                <span class="input-group-addon"><i class="fa fa-align-justify"></i></span>
                {{ form_widget(form.titre, {'attr': {'class': 'form-control', 'id': 'titreInput'}}) }}
            </div>
            <div class="error-message" id="titreError"></div>
             {% if form_errors(form.titre) %}
                                    <div class="alert alert-danger">
                                        {{ form_errors(form.titre) }}
                                    </div>
                                {% endif %}
        </div>
    </div>
</div>

<div class="row">
    <!-- Contenu -->
    <div class="col-md-12">
        <div class="form-group">
            {{ form_label(form.contenu) }}
            <div class="input-group">
                <span class="input-group-addon"><i class="fa fa-align-justify"></i></span>
                {{ form_widget(form.contenu, {'attr': {'class': 'form-control', 'id': 'contenuInput'}}) }}
            </div>
             {% if form_errors(form.contenu) %}
                                    <div class="alert alert-danger">
                                        {{ form_errors(form.contenu) }}
                                    </div>
                                {% endif %}
        </div>
    </div>
</div>

<!-- Image -->
<div class="row">
    <div class="col-md-6">
        <div class="form-group">
            {{ form_label(form.image) }}
            <div class="input-group">
                <span class="input-group-addon"><i class="fa fa-image"></i></span>
                {{ form_widget(form.image, {'attr': {'class': 'form-control', 'id': 'fileInput', 'accept': '.jpg, .jpeg, .png'}}) }}
            </div>
             {% if form_errors(form.image) %}
                                    <div class="alert alert-danger">
                                        {{ form_errors(form.image) }}
                                    </div>
                                {% endif %}
        </div>
    </div>
    <!-- Id_agent -->
    <div class="col-md-6">
        <div class="form-group">
            {{ form_label(form.id_agent) }}
            <div class="input-group">
                <span class="input-group-addon"><i class="fa fa-id-card"></i></span>
                {{ form_widget(form.id_agent, {'attr': {'class': 'form-control', 'id': 'idAgentInput'}}) }}
            </div>
            {% if form_errors(form.id_agent) %}
                                    <div class="alert alert-danger">
                                        {{ form_errors(form.id_agent) }}
                                    </div>
                                {% endif %}
        </div>
    </div>
</div>
<!-- Other form fields... -->

<!-- Submit button -->
<div class="row">
    <button type="submit" class="{{ button_css|default('submitbtn') }}">
        <i class="fa fa-plus"></i> {{ button_label|default('Ajouter'|trans) }}
    </button>
</div>
{{ form_end(form) }}

