{% for article in articles %}
{% set form = forms[loop.index0] %}
<div class="modal fade" id="modal-sup-{{ article.id }}" tabindex="" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form method="post" action="{{ path('app_article_delete', {'id': article.id}) }}">
                <div class="card2">
                    <div class="card2-content  text-center">
    <p class="card2-heading">Êtes-vous sûr de vouloir supprimer cette article ?</p>
    <p class="card2-description">
        <strong>Editeur et titre de larticle :</strong> {{  
        article.getIdAgent.nom ~ " " ~ article.getIdAgent.prenom }} - {{ article.titre
         }}<br>
       
        <!-- Ajoutez d'autres informations du client selon vos besoins -->
    </p>
</div>

                    <div class="card2-button-wrapper">
                        <button class="card2-button secondary" data-dismiss="modal">Annuler</button>
                        <button class="card2-button primary">Confirmer la Suppression</button>
                    </div>
                </div>
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ article.id) }}">
            </form>
        </div>
    </div>
</div>
    
     <div class="modal fade" id="modal_ed-{{ article.id }}" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
      <div class="box-header">
                    <h3 class="box-title">Formulaire De Modification / Affichage</h3>
                </div>                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
<span aria-hidden="true"><i style="color:red; font-size: 20px;" class="fa fa-close"></i></span>
                    </button>
                </div>
                <div class="modal-body">
                    {{ include('article/_form_edit.html.twig', {'button_label': 'Update'}) }}

                  

                    <!-- Formulaire pour la modification du client -->
                    
                </div>
                <div class="modal-footer">
                     <div class="alert alert-warning" role="alert">
                        <strong>Attention :</strong> La modification des informations de l est irréversible. Assurez-vous de vérifier attentivement avant de procéder.
                    </div>
                </div>
            </div>
        </div>
    </div>
 <div class="modal fade" id="modal-{{ article.id }}" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
   <div class="modal-dialog" role="document">
     <div class="modal-content">
       <div class="modal-header">
         <div class="box-header">
           <h3 class="box-title">Preview {{ article.titre }}</h3>
         </div>
         <button type="button" class="close" data-dismiss="modal" aria-label="Close">
           <span aria-hidden="true">
             <i style="color:red; font-size: 20px;" class="fa fa-close"></i>
           </span>
         </button>
       </div>
       <div class="modal-body">
        <iframe id="iframe-{{article.id}}" src="{{path('app_article_show', {'id': article.id}) }}" frameborder="0" style="width: 100%; height: 400px;"></iframe>
         <!-- Formulaire pour la modification du client -->
       </div>
       <div class="modal-footer">
         <div class="alert alert-warning" role="alert">
           <strong>Attention :</strong> La modification des informations de l est irréversible. Assurez-vous de vérifier attentivement avant de procéder.
         </div>
       </div>
     </div>
   </div>
 </div>
<script>
document.getElementById("previewbutton-{{ article.id }}").addEventListener('click', function() {
    // Accessing the iframe element
    var iframe = document.getElementById('iframe-{{ article.id }}').contentWindow.document;

    // Adding a delay to ensure the iframe content loads before hiding it
    setTimeout(function() {
       //  Hiding the iframe content
        iframe.getElementById('preview-{{ article.id }}').classList.add("display-none");
          iframe.getElementById('footer-{{ article.id }}').classList.add("display-none");
            iframe.getElementById('navbar-{{ article.id }}').classList.add("display-none");
                  iframe.getElementById('header-{{ article.id }}').classList.add("display-none");
    }, 10); // Adjust the delay time (in milliseconds) as needed
});
</script>


{% endfor %}

